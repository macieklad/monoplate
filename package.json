{
  "name": "monoplate",
  "private": true,
  "packageManager": "bun@1.3.5",
  "scripts": {
    "build": "turbo run build",
    "build:ecosystem": "turbo run build --filter='./tools/*' --filter='./packages/*'",
    "changeset": "changeset",
    "clean": "turbo run clean && rm -rf node_modules",
    "dev": "turbo run dev --no-cache --parallel --continue",
    "dev:color": "FORCE_COLOR=1 bun run dev",
    "format": "biome format --write .",
    "lint": "turbo run lint",
    "lint:affected": "turbo run lint --affected",
    "prepare": "is-ci || husky install",
    "release": "bun run build:ecosystem && changeset publish",
    "sync": "syncpack fix-mismatches",
    "sync:list-mismatches": "syncpack list-mismatches",
    "test": "turbo run test",
    "test:affected": "turbo run test --affected",
    "version-packages": "changeset version"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.8",
    "@playwright/test": "^1.56.1",
    "@total-typescript/ts-reset": "^0.6.1",
    "@types/node": "^24.9.1",
    "husky": "^9.1.6",
    "is-ci": "^3.0.1",
    "lint-staged": "^16.2.6",
    "syncpack": "^13.0.4",
    "turbo": "^2.5.8",
    "@biomejs/biome": "^2.3.1"
  },
  "lint-staged": {
    "*.{js,ts,mjs,mts,jsx,tsx,json,jsonc,css,md,yml,yaml}": [
      "biome check --write --no-errors-on-unmatched",
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "workspaces": [
    "packages/*",
    "apps/*",
    "./.github/actions/*"
  ]
}
